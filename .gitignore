*.tmp
*.log
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/features/*
!data/features/.gitkeep

# IDEs
.vscode/
.idea/
*.swp
*.swo

# MacOS
.DS_Store
