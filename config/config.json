{
  "data_provider": "yfinance",
  "historical_lookback_years": 3,
  "prediction_horizons": [1, 3, 5, 10, 20],
  "indicator_params": {
    "sma_periods": [5, 10, 20, 50, 100, 200],
    "ema_periods": [9, 20, 50, 200],
    "rsi_period": 14,
    "stoch_rsi_period": 14,
    "macd": {
      "fast": 12,
      "slow": 26,
      "signal": 9
    },
    "atr_period": 14,
    "bollinger_bands": {
      "period": 20,
      "std_dev": 2.0
    },
    "volatility_period": 20,
    "volume_sma_period": 20
  },
  "score_weights": {
    "technical": 0.25,
    "momentum": 0.20,
    "volume": 0.15,
    "relative_strength": 0.15,
    "volatility": 0.10,
    "sector": 0.10,
    "fundamental": 0.05
  },
  "backtest": {
    "initial_capital": 1000000.0,
    "transaction_fee_pct": 0.001,
    "slippage_pct": 0.0005,
    "max_position_size_pct": 0.1
  },
  "logging": {
    "level": "INFO",
    "log_to_file": true,
    "log_file_path": "logs/pipeline.log"
  }
}
