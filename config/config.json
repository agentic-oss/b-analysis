{
  "project_name": "Indian Stock Market Daily Analysis Engine",
  "version": "1.0.0",
  "data_provider": {
    "primary": "yfinance",
    "timeout_seconds": 30,
    "max_retries": 3,
    "retry_backoff_factor": 1.5,
    "rate_limit_delay_seconds": 0.2
  },
  "storage": {
    "base_dir": "data",
    "raw_dir": "data/raw",
    "processed_dir": "data/processed",
    "features_dir": "data/features",
    "analysis_dir": "data/analysis",
    "predictions_dir": "data/predictions",
    "reports_dir": "reports/daily",
    "quality_dir": "data/quality",
    "format": "parquet",
    "export_csv": true,
    "export_json": true
  },
  "indicators": {
    "sma_periods": [5, 10, 20, 50, 100, 200],
    "ema_periods": [9, 20, 50, 200],
    "rsi_period": 14,
    "stoch_rsi_period": 14,
    "stoch_rsi_k": 3,
    "stoch_rsi_d": 3,
    "macd": {
      "fast": 12,
      "slow": 26,
      "signal": 9
    },
    "roc_period": 12,
    "atr_period": 14,
    "bollinger": {
      "period": 20,
      "std_dev": 2.0
    },
    "volume_sma_period": 20,
    "historical_volatility_period": 20
  },
  "scoring": {
    "weights": {
      "technical_trend": 0.25,
      "momentum": 0.20,
      "volume": 0.15,
      "relative_strength": 0.15,
      "volatility": 0.10,
      "market_regime": 0.05,
      "sector": 0.05,
      "fundamentals": 0.05
    },
    "labels": {
      "80-100": "Very Strong",
      "65-79": "Strong",
      "50-64": "Neutral",
      "35-49": "Weak",
      "0-34": "Very Weak"
    }
  },
  "pattern_matching": {
    "similarity_threshold": 0.85,
    "min_historical_matches": 10,
    "max_analogue_matches": 50,
    "forward_horizons": [1, 3, 5, 10, 20]
  },
  "backtesting": {
    "initial_capital": 1000000.0,
    "transaction_cost_pct": 0.001,
    "slippage_pct": 0.0005,
    "position_size_pct": 0.10
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s"
  }
}
