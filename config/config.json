{
  "pipeline": {
    "default_lookback_years": 2,
    "primary_data_provider": "yfinance",
    "log_level": "INFO"
  },
  "storage": {
    "base_dir": "data",
    "raw_dir": "data/raw",
    "processed_dir": "data/processed",
    "features_dir": "data/features",
    "analysis_dir": "data/analysis",
    "predictions_dir": "data/predictions",
    "reports_dir": "reports",
    "quality_dir": "data/quality"
  },
  "indicators": {
    "sma_periods": [5, 10, 20, 50, 100, 200],
    "ema_periods": [9, 20, 50, 200],
    "rsi_period": 14,
    "stoch_rsi_period": 14,
    "macd": { "fast": 12, "slow": 26, "signal": 9 },
    "atr_period": 14,
    "volatility_period": 20,
    "bollinger": { "period": 20, "std_dev": 2 },
    "volume_sma_period": 20
  },
  "scoring": {
    "weights": {
      "technical_trend": 0.25,
      "momentum": 0.20,
      "volume": 0.15,
      "relative_strength": 0.15,
      "volatility": 0.10,
      "market_regime": 0.05,
      "sector": 0.05,
      "fundamental": 0.05
    }
  },
  "analogues": {
    "min_lookback_days": 250,
    "similarity_threshold": 0.85,
    "horizons": [1, 3, 5, 10, 20]
  },
  "prediction": {
    "horizons": [1, 3, 5, 10, 20],
    "models": ["historical_prob", "logistic_regression", "random_forest"]
  },
  "backtesting": {
    "initial_capital": 100000.0,
    "transaction_cost_pct": 0.001,
    "slippage_pct": 0.0005,
    "max_position_pct": 0.2
  }
}
