{
  "data_provider": "yfinance",
  "historical_lookback_years": 2,
  "data_dirs": {
    "raw": "data/raw",
    "processed": "data/processed",
    "features": "data/features",
    "analysis": "data/analysis",
    "predictions": "data/predictions",
    "quality": "data/quality",
    "reports": "reports/daily"
  },
  "indicators": {
    "sma_periods": [5, 10, 20, 50, 100, 200],
    "ema_periods": [9, 20, 50, 200],
    "rsi_period": 14,
    "stoch_rsi_period": 14,
    "macd_fast": 12,
    "macd_slow": 26,
    "macd_signal": 9,
    "roc_period": 12,
    "momentum_period": 10,
    "atr_period": 14,
    "bollinger_period": 20,
    "bollinger_std": 2,
    "volatility_period": 20,
    "volume_sma_period": 20
  },
  "score_weights": {
    "technical_trend": 0.25,
    "momentum": 0.20,
    "volume": 0.15,
    "relative_strength": 0.15,
    "volatility": 0.10,
    "market_regime": 0.05,
    "sector": 0.05,
    "fundamental": 0.05
  },
  "analogues": {
    "horizons": [1, 3, 5, 10, 20],
    "similarity_threshold": 0.85,
    "min_matches": 5,
    "top_n_matches": 30
  },
  "backtest": {
    "initial_capital": 1000000,
    "transaction_cost_pct": 0.001,
    "slippage_pct": 0.0005,
    "position_size_pct": 0.10
  },
  "logging_level": "INFO"
}
