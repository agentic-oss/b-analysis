{
  "data_provider": {
    "default": "yfinance",
    "timeout": 15,
    "max_retries": 3,
    "retry_backoff_factor": 1.5,
    "historical_lookback_years": 3
  },
  "storage": {
    "format": "parquet",
    "export_csv": true,
    "export_json": true
  },
  "indicators": {
    "sma_periods": [5, 10, 20, 50, 100, 200],
    "ema_periods": [9, 20, 50, 200],
    "rsi_period": 14,
    "stoch_rsi_period": 14,
    "macd_fast": 12,
    "macd_slow": 26,
    "macd_signal": 9,
    "atr_period": 14,
    "bollinger_period": 20,
    "bollinger_std": 2.0,
    "volatility_lookback": 20
  },
  "scoring": {
    "weights": {
      "technical_trend": 0.25,
      "momentum": 0.20,
      "volume": 0.15,
      "relative_strength": 0.15,
      "volatility": 0.10,
      "market_regime": 0.10,
      "sector": 0.05
    }
  },
  "patterns": {
    "analogue_min_history_days": 100,
    "analogue_match_threshold": 0.85,
    "forward_horizons": [1, 3, 5, 10, 20]
  },
  "backtest": {
    "transaction_cost_pct": 0.001,
    "slippage_pct": 0.0005,
    "initial_capital": 1000000.0
  },
  "logging": {
    "level": "INFO",
    "file": "logs/pipeline.log"
  }
}
