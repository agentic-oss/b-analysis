{
  "pipeline": {
    "default_provider": "yfinance",
    "historical_lookback_years": 3,
    "prediction_horizons": [1, 3, 5, 10, 20],
    "log_level": "INFO"
  },
  "indicators": {
    "sma_periods": [5, 10, 20, 50, 100, 200],
    "ema_periods": [9, 20, 50, 200],
    "rsi_period": 14,
    "stoch_rsi_period": 14,
    "macd_fast": 12,
    "macd_slow": 26,
    "macd_signal": 9,
    "atr_period": 14,
    "bollinger_period": 20,
    "bollinger_std": 2.0
  },
  "scoring": {
    "weights": {
      "technical_trend": 0.25,
      "momentum": 0.25,
      "volume": 0.15,
      "relative_strength": 0.15,
      "market_regime": 0.10,
      "fundamental": 0.10
    }
  },
  "backtesting": {
    "initial_capital": 1000000.0,
    "transaction_cost_pct": 0.001,
    "slippage_pct": 0.0005,
    "max_position_size": 0.1
  }
}
