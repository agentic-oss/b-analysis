{
  "pipeline": {
    "data_provider": "yfinance",
    "lookback_days": 365,
    "max_retries": 3,
    "retry_backoff_sec": 2,
    "timeout_sec": 15,
    "logging_level": "INFO"
  },
  "storage": {
    "base_dir": "data",
    "use_parquet": true
  },
  "scoring": {
    "weights": {
      "technical_trend": 0.25,
      "momentum": 0.20,
      "volume": 0.15,
      "relative_strength": 0.15,
      "volatility": 0.10,
      "market_regime": 0.10,
      "fundamental": 0.05
    }
  },
  "patterns": {
    "analogue_top_k": 25,
    "similarity_threshold": 0.85,
    "horizons": [1, 3, 5, 10, 20]
  },
  "backtesting": {
    "initial_capital": 1000000.0,
    "transaction_cost_pct": 0.001,
    "slippage_pct": 0.0005,
    "max_position_pct": 0.10
  }
}
