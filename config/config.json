{
  "provider": {
    "default": "yfinance",
    "timeout_seconds": 30,
    "max_retries": 3,
    "retry_backoff_factor": 1.5,
    "rate_limit_delay_seconds": 0.5
  },
  "pipeline": {
    "lookback_days": 730,
    "min_history_days": 60,
    "data_dir": "data",
    "reports_dir": "reports"
  },
  "indicators": {
    "sma_periods": [5, 10, 20, 50, 100, 200],
    "ema_periods": [9, 20, 50, 200],
    "rsi_period": 14,
    "stoch_rsi_period": 14,
    "macd_fast": 12,
    "macd_slow": 26,
    "macd_signal": 9,
    "atr_period": 14,
    "bollinger_period": 20,
    "bollinger_std": 2.0,
    "volume_sma_period": 20
  },
  "scoring_weights": {
    "technical_trend": 0.25,
    "momentum": 0.20,
    "volume": 0.15,
    "relative_strength": 0.15,
    "market_regime": 0.10,
    "sector": 0.10,
    "fundamental": 0.05
  },
  "horizons": [1, 3, 5, 10, 20],
  "backtesting": {
    "initial_capital": 100000.0,
    "transaction_cost_pct": 0.001,
    "slippage_pct": 0.0005,
    "position_size_pct": 0.10
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s"
  }
}
