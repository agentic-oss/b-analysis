{
  "pipeline": {
    "data_provider": "yfinance",
    "historical_lookback_years": 3,
    "log_level": "INFO",
    "fallback_to_mock_on_error": true
  },
  "storage": {
    "base_data_dir": "data",
    "reports_dir": "reports",
    "save_parquet": true,
    "save_csv": true,
    "save_json": true
  },
  "indicators": {
    "sma_periods": [5, 10, 20, 50, 100, 200],
    "ema_periods": [9, 20, 50, 200],
    "rsi_period": 14,
    "stoch_rsi_period": 14,
    "macd": {
      "fast": 12,
      "slow": 26,
      "signal": 9
    },
    "atr_period": 14,
    "bollinger": {
      "period": 20,
      "std_dev": 2.0
    },
    "roc_period": 10,
    "momentum_period": 10,
    "volume_sma_period": 20
  },
  "scoring": {
    "weights": {
      "technical_trend": 0.25,
      "momentum": 0.20,
      "volume": 0.15,
      "relative_strength": 0.15,
      "volatility": 0.10,
      "market_regime": 0.10,
      "sector": 0.05
    }
  },
  "prediction": {
    "horizons": [1, 3, 5, 10, 20],
    "analogue_max_matches": 30,
    "analogue_rsi_tolerance": 7.0,
    "analogue_volatility_tolerance": 0.05
  },
  "backtest": {
    "initial_capital": 1000000.0,
    "transaction_cost_pct": 0.001,
    "slippage_pct": 0.0005,
    "max_position_size_pct": 0.10
  }
}
