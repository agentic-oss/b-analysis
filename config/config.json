{
  "data_provider": "yfinance",
  "historical_lookback_years": 5,
  "default_fetch_days": 365,
  "retry_attempts": 3,
  "retry_delay_seconds": 2,
  "timeout_seconds": 30,
  "score_weights": {
    "technical_trend": 0.25,
    "momentum": 0.20,
    "volume": 0.15,
    "relative_strength": 0.15,
    "volatility": 0.10,
    "market_regime": 0.10,
    "fundamental": 0.05
  },
  "prediction_horizons": [1, 3, 5, 10, 20],
  "analogue_matching": {
    "min_matches": 5,
    "rsi_tolerance": 5.0,
    "volatility_tolerance": 0.05,
    "similarity_top_k": 30
  },
  "backtest": {
    "initial_capital": 1000000.0,
    "transaction_cost_pct": 0.001,
    "slippage_pct": 0.0005,
    "max_position_pct": 0.10
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  }
}
