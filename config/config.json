{
  "pipeline": {
    "historical_lookback_days": 365,
    "max_retries": 3,
    "retry_backoff_sec": 2,
    "request_timeout_sec": 10
  },
  "storage": {
    "base_dir": "data",
    "reports_dir": "reports"
  },
  "indicator_params": {
    "sma_periods": [5, 10, 20, 50, 100, 200],
    "ema_periods": [9, 20, 50, 200],
    "rsi_period": 14,
    "stoch_rsi_period": 14,
    "macd_fast": 12,
    "macd_slow": 26,
    "macd_signal": 9,
    "roc_period": 10,
    "atr_period": 14,
    "bollinger_period": 20,
    "bollinger_std": 2.0
  },
  "score_weights": {
    "technical_trend": 0.25,
    "momentum": 0.20,
    "volume": 0.15,
    "relative_strength": 0.15,
    "volatility": 0.10,
    "market_regime": 0.05,
    "sector": 0.05,
    "fundamental": 0.05
  },
  "prediction_horizons": [1, 3, 5, 10, 20],
  "backtest_assumptions": {
    "slippage_pct": 0.0005,
    "transaction_fee_pct": 0.001,
    "initial_capital": 100000.0
  },
  "logging": {
    "level": "INFO"
  }
}
