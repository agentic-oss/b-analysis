{
  "provider": {
    "default_provider": "yfinance",
    "timeout": 30,
    "max_retries": 3,
    "backoff_factor": 1.5,
    "rate_limit_delay": 0.5
  },
  "storage": {
    "base_dir": "data",
    "primary_format": "parquet",
    "export_formats": ["csv", "json"]
  },
  "indicators": {
    "sma_periods": [5, 10, 20, 50, 100, 200],
    "ema_periods": [9, 20, 50, 200],
    "rsi_period": 14,
    "stoch_rsi_period": 14,
    "macd_fast": 12,
    "macd_slow": 26,
    "macd_signal": 9,
    "atr_period": 14,
    "bollinger_period": 20,
    "bollinger_std": 2.0,
    "volatility_lookback": 20
  },
  "scoring": {
    "weights": {
      "technical_trend": 0.20,
      "momentum": 0.20,
      "volume": 0.15,
      "relative_strength": 0.15,
      "volatility": 0.10,
      "market_regime": 0.10,
      "sector": 0.10
    }
  },
  "analogue": {
    "lookback_years": 5,
    "horizons": [1, 3, 5, 10, 20],
    "min_samples": 5,
    "top_k": 20
  },
  "backtest": {
    "initial_capital": 1000000.0,
    "transaction_cost_pct": 0.001,
    "slippage_pct": 0.0005,
    "position_size_pct": 0.10
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  }
}
