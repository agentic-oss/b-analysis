{
  "pipeline": {
    "default_lookback_years": 5,
    "min_required_days": 200,
    "max_retries": 3,
    "retry_backoff_seconds": 2,
    "timeout_seconds": 30
  },
  "indicators": {
    "sma_periods": [5, 10, 20, 50, 100, 200],
    "ema_periods": [9, 20, 50, 200],
    "rsi_period": 14,
    "stoch_rsi_period": 14,
    "macd_fast": 12,
    "macd_slow": 26,
    "macd_signal": 9,
    "roc_period": 12,
    "atr_period": 14,
    "bollinger_period": 20,
    "bollinger_std": 2.0,
    "volatility_period": 20
  },
  "scoring": {
    "weights": {
      "technical": 0.35,
      "momentum": 0.25,
      "volume": 0.15,
      "relative_strength": 0.15,
      "market_sector": 0.10
    }
  },
  "prediction": {
    "horizons": [1, 3, 5, 10, 20],
    "analogue_min_matches": 10,
    "models": ["historical_analogue", "logistic_regression", "random_forest"]
  },
  "backtest": {
    "initial_capital": 1000000,
    "transaction_cost_pct": 0.001,
    "slippage_pct": 0.0005,
    "position_size_pct": 0.10
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s"
  }
}
